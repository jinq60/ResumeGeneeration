# 服务器生产/测试环境变量示例
# 复制为 /opt/resume-generation/.env 并替换所有 <...> 为真实值

# MySQL（必须替换为强随机口令，禁止使用示例默认值）
MYSQL_ROOT_PASSWORD=<strong-random-password>
MYSQL_DATABASE=resume_generation
MYSQL_USER=resume
MYSQL_PASSWORD=<strong-random-password>
# 数据库/存储端口仅绑定宿主 127.0.0.1 供本机调试；如无需可留空以完全关闭对外发布
MYSQL_PORT=127.0.0.1:3306

# MinIO（必须替换为强随机口令，禁止使用 minioadmin 默认值）
MINIO_ROOT_USER=<minio-admin-user>
MINIO_ROOT_PASSWORD=<strong-random-password>
MINIO_API_PORT=127.0.0.1:9000
MINIO_CONSOLE_PORT=127.0.0.1:9001

# Redis（必须配置密码，容器不对外发布端口）
REDIS_PASSWORD=<strong-random-password>

# JWT（需 base64 编码的 256-bit 以上密钥）
JWT_SECRET=<base64-encoded-256-bit-secret>

# CORS 允许的前端地址（容器化后前端默认 80 端口，记得加入 http://<server-ip>）
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://<server-ip>:5173,http://<server-ip>

# Spring Boot 容器内直接使用变量（建议与上面保持一致）
SPRING_DATASOURCE_USERNAME=resume
SPRING_DATASOURCE_PASSWORD=<strong-random-password>
SPRING_DATA_REDIS_PASSWORD=<strong-random-password>
APP_JWT_SECRET=<base64-encoded-256-bit-secret>
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://<server-ip>:5173,http://<server-ip>
APP_MINIO_ACCESS_KEY=<minio-admin-user>
APP_MINIO_SECRET_KEY=<strong-random-password>

# MinIO bucket names（生产环境建议自定义，避免使用默认值）
APP_MINIO_BUCKET_AVATARS=resume-avatars
APP_MINIO_BUCKET_PDFS=resume-pdfs
APP_MINIO_BUCKET_TEMPLATES=resume-templates

# PDF 渲染时 /uploads/** 相对路径的外部前缀（若前端通过 80 端口访问则填 http://<server-ip>）
APP_PUBLIC_BASE_URL=http://<server-ip>

# 首个管理员引导（仅当系统尚无任何 ADMIN 账号时生效；初始化完成后建议移除）
ADMIN_BOOTSTRAP_PHONE=<admin-phone>
ADMIN_BOOTSTRAP_PASSWORD=<strong-password-8-32-with-letter-and-digit>
ADMIN_BOOTSTRAP_NICKNAME=管理员

# 验证码模式：生产必须为 strict（未接入真实验证码服务时注册将被拒绝，防止占位验证码裸奔）
VERIFY_CODE_MODE=strict

# 邮箱验证码 SMTP（QQ 邮箱：smtp.qq.com:465 SSL，密码为邮箱授权码而非登录密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=<qq-email>
SMTP_PASSWORD=<smtp-auth-code>
SMTP_FROM=<qq-email>
# QQ 465 端口必须开启 SSL；若使用 587 端口则改为 true 并将 SSL 设为 false
SMTP_SSL_ENABLE=true
SMTP_STARTTLS_ENABLE=false
# 465 隐式 SSL 如遇连接问题，可显式指定 socketFactory（Spring Boot 3 使用 jakarta.net.ssl.SSLSocketFactory）
# SMTP_SOCKET_FACTORY_CLASS=jakarta.net.ssl.SSLSocketFactory
# SMTP_SOCKET_FACTORY_PORT=465

# GitHub OAuth（https://github.com/settings/developers → OAuth Apps）
# 回调地址：{AUTH_OAUTH_BASE_URL}/auth/oauth/github/callback
GITHUB_CLIENT_ID=<client-id>
GITHUB_CLIENT_SECRET=<client-secret>

# Google OAuth（https://console.cloud.google.com → APIs & Services → Credentials）
# 回调地址：{AUTH_OAUTH_BASE_URL}/auth/oauth/google/callback
GOOGLE_CLIENT_ID=<client-id>
GOOGLE_CLIENT_SECRET=<client-secret>

# 公共 OAuth 配置
AUTH_OAUTH_BASE_URL=http://localhost:8080/api
AUTH_OAUTH_FRONTEND_REDIRECT=http://localhost:5173/login

# 安全风控（可选调优）
GUEST_MAX_PER_IP_PER_DAY=50
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
