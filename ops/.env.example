# 服务器生产/测试环境变量示例
# 复制为 /opt/resume-generation/.env 并替换所有 <...> 为真实值

# MySQL
MYSQL_ROOT_PASSWORD=ResumeRoot123
MYSQL_DATABASE=resume_generation
MYSQL_USER=resume
MYSQL_PASSWORD=ResumeDev123
MYSQL_PORT=3306

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# JWT（需 base64 编码的 256-bit 以上密钥）
JWT_SECRET=<base64-encoded-256-bit-secret>

# CORS 允许的前端地址（容器化后前端默认 80 端口，记得加入 http://<server-ip>）
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://<server-ip>:5173,http://<server-ip>

# Spring Boot 容器内直接使用变量（建议与上面保持一致）
SPRING_DATASOURCE_USERNAME=resume
SPRING_DATASOURCE_PASSWORD=ResumeDev123
APP_JWT_SECRET=<base64-encoded-256-bit-secret>
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://<server-ip>:5173,http://<server-ip>
APP_MINIO_ACCESS_KEY=minioadmin
APP_MINIO_SECRET_KEY=minioadmin123

# MinIO bucket names（生产环境建议自定义，避免使用默认值）
APP_MINIO_BUCKET_AVATARS=resume-avatars
APP_MINIO_BUCKET_PDFS=resume-pdfs
APP_MINIO_BUCKET_TEMPLATES=resume-templates

# PDF 渲染时 /uploads/** 相对路径的外部前缀（若前端通过 80 端口访问则填 http://<server-ip>）
APP_PUBLIC_BASE_URL=http://<server-ip>

# 首个管理员引导（仅当系统尚无任何 ADMIN 账号时生效；初始化完成后建议移除）
ADMIN_BOOTSTRAP_PHONE=<admin-phone>
ADMIN_BOOTSTRAP_PASSWORD=<strong-password-8-32-with-letter-and-digit>
ADMIN_BOOTSTRAP_NICKNAME=管理员

# 验证码模式：生产必须为 strict（未接入真实验证码服务时注册将被拒绝，防止占位验证码裸奔）
VERIFY_CODE_MODE=strict

# 安全风控（可选调优）
GUEST_MAX_PER_IP_PER_DAY=50
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
